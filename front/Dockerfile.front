# Etapa 1: Build de React con Vite
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# Vite construirá de forma agnóstica sin VITE_API_URL
RUN npm run build

# Etapa 2: Servidor Nginx (non-root - HU-OIEM-08 / F-08 & HU-OIEM-09 / F-10)
FROM nginx:alpine

# Copiamos la build de Vite y configuración segura de Nginx
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Script de entrada para inyectar variables de entorno en runtime
COPY env.sh /docker-entrypoint.d/
RUN tr -d '\r' < /docker-entrypoint.d/env.sh > /docker-entrypoint.d/env_temp.sh && \
    mv /docker-entrypoint.d/env_temp.sh /docker-entrypoint.d/env.sh && \
    chmod +x /docker-entrypoint.d/env.sh && \
    chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid && \
    sed -i 's/^user  nginx;/# user nginx;/' /etc/nginx/nginx.conf

USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
