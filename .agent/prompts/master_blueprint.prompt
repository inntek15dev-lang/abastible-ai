        ]}
      ]
    },

    "security_hardening": {
      "standard": "IEEE 7000 (Privacy by Design)",
      "auth_policy": "JWT_HS256",
      "compliance_gap": "[CORREGIDO — hallazgo crítico] El schema STRICT MODE exige AES_ENCRYPT()/AES_DECRYPT() a nivel de BD para todo campo is_pii:true. La implementación real NO cumple esto: ningún campo PII de las tablas users/contratistas/registros/registro_actividades/hallazgos está cifrado en la base de datos — se almacenan en texto plano. Solo users.password cumple la mitad del mandato (hashing bcrypt en capa de aplicación). Se documenta como gap de cumplimiento real, no se simula un cumplimiento que no existe en el código.",
      "encryption_targets": ["users.password (bcrypt, app-layer, ÚNICO campo realmente protegido)"],
      "pii_fields_sin_cifrar_en_reposo": [
        "users.name", "users.usuario", "users.email", "users.rut", "users.telefono", "users.eecc_nombre",
        "contratistas.rut", "contratistas.direccion", "contratistas.telefono", "contratistas.email_contacto",
        "registros.eecc_nombre",
        "registro_actividades.responsable"
      ],
      "audit_logic": "Global_Event_Sourcing parcial — cubierto por registro_logs (por Registro) y auditoria_comentarios; NO existe un log de auditoría global a nivel de sistema (p.ej. cambios de privilegios, altas/bajas de usuario) fuera del alcance de un Registro específico.",
      "sso_token_encryption": "AES-256-CBC (crypto-js), interoperable con un emisor PHP — usado únicamente para el handshake de login externo, no para datos en reposo.",
      "rbac_policy_real": {
        "evaluation_order": ["1: module==='OVAL' -> solo role==='oval' pasa (ni admin)", "2: role==='admin'||role==='oval' -> pasa cualquier otro módulo", "3: role==='contratista_admin' && module==='Usuarios' -> pasa (hardcode)", "4: privilegio con ref_modulo:'*' -> pasa", "5: privilegio específico de módulo+acción -> pasa", "6: 403"],
        "admin": {"seed_estatico": ["*"], "actions": ["read","write","excec"], "excepcion": "OVAL (403 incluso siendo admin)"},
        "oval": {"seed_estatico": ["*", "OVAL"], "actions": ["read","write","excec"]},
        "administrador_contrato": {"seed_estatico_adicional": ["Auditoria","Reportes","Registros_Exportar"], "seed_dinamico": ["Dashboard","Registros(read-only)","Contratistas","Reaperturas","Compromisos","Auditoria","Reportes","Registros_Exportar","Programas","Vinculaciones","Gestion_Configuracion(write,no-excec)"], "parche_posterior": "patch_audit_privileges.js revoca excec sobre Registros si lo tuviera"},
        "contratista_admin": {"seed_dinamico": ["Dashboard","Registros(write)","Evidencias(write)","Reaperturas","Usuarios(write, +hardcode)","Compromisos","Reportes","Registros_Exportar","Programas","Vinculaciones"]},
        "contratista_user": {"seed_dinamico": ["Dashboard","Registros(write)","Evidencias(write)","Usuarios(write)","Registros_Exportar","Programas","Vinculaciones"], "frontend_hardcode_adicional": "Compromisos (coincide con lo ya otorgado por seed, redundante)"}
      }
    }
  }
}
```

