{
    "sprint": 4,
    "name": "Dashboard KPIs + Reportes",
    "priority": "COULD",
    "user_stories": [
        "US-008",
        "US-009"
    ],
    "endpoints": [
        {
            "method": "GET",
            "path": "/api/dashboard/kpis",
            "controller": "dashboardController",
            "description": "Métricas generales del sistema"
        },
        {
            "method": "GET",
            "path": "/api/dashboard/cumplimiento",
            "controller": "dashboardController",
            "description": "Datos de cumplimiento por contratista"
        },
        {
            "method": "GET",
            "path": "/api/reportes/registro/:id/pdf",
            "controller": "reporteController",
            "description": "Exportar registro a PDF"
        },
        {
            "method": "GET",
            "path": "/api/reportes/cumplimiento",
            "controller": "reporteController",
            "description": "Reporte de cumplimiento general"
        }
    ],
    "pages": [
        {
            "path": "/reportes",
            "component": "ReporteList",
            "module": "Reportes"
        }
    ]
}