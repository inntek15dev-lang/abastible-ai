{
    "sprint": 5,
    "name": "Gestión Documental + Licitaciones",
    "priority": "SHOULD",
    "user_stories": [
        "US-011",
        "US-012",
        "US-013"
    ],
    "entities": [
        "licitaciones",
        "postulaciones",
        "documentos"
    ],
    "endpoints": [
        {
            "method": "GET",
            "path": "/api/licitaciones",
            "controller": "licitacionController",
            "description": "Listar licitaciones disponibles"
        },
        {
            "method": "POST",
            "path": "/api/licitaciones",
            "controller": "licitacionController",
            "description": "Crear nueva licitación (Admin)"
        },
        {
            "method": "POST",
            "path": "/api/licitaciones/:id/postular",
            "controller": "postulacionController",
            "description": "Postular a licitación (Contratista)"
        },
        {
            "method": "POST",
            "path": "/api/documentos/upload",
            "controller": "documentoController",
            "description": "Subir documento general"
        }
    ],
    "pages": [
        {
            "path": "/licitaciones",
            "component": "LicitacionList",
            "module": "Licitaciones"
        },
        {
            "path": "/mis-postulaciones",
            "component": "PostulacionList",
            "module": "Licitaciones"
        }
    ]
}